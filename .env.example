# Proxy pour les etapes RUN des builds (apt, pip).
# Les conteneurs de build n'ont pas de sortie internet directe sur les
# machines internes : sans ces variables, apt-get/pip echouent en
# "no route to host".
#
# Usage : cp .env.example .env   (le .env est lu automatiquement par
# docker compose et n'est pas versionne)
HTTP_PROXY=http://proxy.mgt.proxad.net:3128
HTTPS_PROXY=http://proxy.mgt.proxad.net:3128
NO_PROXY=localhost,127.0.0.1,kafka,minio,jobmanager,taskmanager,.proxad.net
